# Copy to .env. Generate your own JWT value: openssl rand -base64 48
# This placeholder intentionally cannot sign JWTs; never deploy it.
JWT_SECRET=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/devpilot
SPRING_DATASOURCE_USERNAME=devpilot
SPRING_DATASOURCE_PASSWORD=devpilot
POSTGRES_PORT=5434
BACKEND_PORT=8083
FRONTEND_PORT=5174
FRONTEND_BASE_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
# Docker: browser callbacks use the same Nginx origin as the connect request.
# Manual dev can use http://localhost:8083/api/github/callback instead.
GITHUB_REDIRECT_URI=http://localhost:5174/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate separately: openssl rand -base64 32. Preserve it for existing encrypted tokens.
GITHUB_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
INDEXING_MAX_FILE_SIZE_BYTES=500000
INDEXING_CHUNK_LINES=100
INDEXING_CHUNK_OVERLAP_LINES=15
INDEXING_MAX_FILES=20000
INDEXING_MAX_TOTAL_BYTES=50000000
INDEXING_MAX_LINE_LENGTH=20000
INDEXING_MAX_CHUNKS=100000
INDEXING_MAX_JOB_SECONDS=1800
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=50
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY_MILLIS=500
CHAT_PROVIDER=openai
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-5-mini
CHAT_TIMEOUT_SECONDS=60
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=30000
RAG_MAX_QUESTION_CHARS=4000
